<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- T-2d63 btapp-launch: -[FBSystemService _isTrustedRequest:...] 0x1a2661814 trusts a caller holding one of the
     *.launchapplications entitlements (test 0x1a2661950 for this one); lsd carries exactly this key (research T-9524 Q2.2-2.3).
     An untrusted caller is refused background/suspended opens; the trusted set also covers the unlock option path. -->
<plist version="1.0">
<dict>
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.springboard.opensensitiveurl</key>
	<true/>
</dict>
</plist>
